# ==========================================
# .gitattributes for Student Book
# Ensures consistent line endings & file types across platforms
# ==========================================

# Auto-detect text files and normalize line endings to LF on commit
* text=auto eol=lf

# Explicit Text File Declarations (Web & Configs)
*.html text eol=lf diff=html
*.css text eol=lf diff=css
*.js text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.json text eol=lf
*.md text eol=lf
*.markdown text eol=lf
*.svg text eol=lf
*.txt text eol=lf
*.xml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# Shell / Scripts
*.sh text eol=lf
*.bash text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Git Configs
.gitattributes text eol=lf
.gitignore text eol=lf

# Binary Assets (Prevent line ending conversion or corruption)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.avif binary
*.pdf binary
*.zip binary
*.tar.gz binary
*.rar binary
*.7z binary

# Font Files
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.otf binary

# Media Files
*.mp3 binary
*.mp4 binary
*.wav binary
*.webm binary
*.ogg binary

# GitHub Release Export Ignore
.gitattributes export-ignore
.gitignore export-ignore
