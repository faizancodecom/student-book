# ==========================================
# .gitignore for Student Book
# Suitable for Public GitHub Repositories
# ==========================================

# ------------------------------------------
# Environment & Secrets (CRITICAL FOR PUBLIC REPOS)
# ------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.pfx
secrets.*
credentials.*

# ------------------------------------------
# Hosting & Deployment
# ------------------------------------------
.vercel
.netlify

# ------------------------------------------
# Node.js & Dependencies (if npm/yarn/pnpm is added)
# ------------------------------------------
node_modules/
jspm_packages/
web_modules/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# ------------------------------------------
# Build Outputs & Caches
# ------------------------------------------
dist/
build/
out/
.cache/
.parcel-cache/
.eslintcache
.stylelintcache

# ------------------------------------------
# Operating System Files
# ------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msm
*.msp
*.lnk

# Linux
*~
.fuse_hidden*
.directory
.Trash-*

# ------------------------------------------
# IDE & Code Editors
# ------------------------------------------
# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# JetBrains (WebStorm, IntelliJ, etc.)
.idea/
*.iws
*.iml

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim / Temporary Files
*.swp
*.swo
*.tmp
*.temp
*.bak
